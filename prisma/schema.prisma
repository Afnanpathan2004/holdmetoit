// HoldMeToIt — Phase 0 persistence schema (Slice 2)
// Authority: FEATURES.md, HANDOFF.md, AGENTS.md Law L1/L4/L5/L8

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (Discord OAuth) — required adapter models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// Discord snowflake (denormalized from Account.providerAccountId for queries / YPT ingest).
  discordId   String?  @unique
  username    String?
  displayName String?
  role        UserRole @default(PARTICIPANT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  hostedChallenges Challenge[] @relation("ChallengeHost")
  participations ChallengeParticipant[]
  overriddenLogs DailyStudyLog[] @relation("LogOverrideAdmin")
  pardonsIssued  PunishmentRecord[] @relation("PardonAdmin")
  teamMemberships    TeamMember[]
  leaderboardEntries LeaderboardEntry[]
  categories         Category[]
  tasks              Task[]
  feedbacks          Feedback[]
  auditLogsWritten   AuditLog[] @relation("AuditLogsWritten")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Challenge operations (Law L1 — unified Team entity)
// ---------------------------------------------------------------------------

model Challenge {
  id               String          @id @default(cuid())
  title            String
  format           ChallengeFormat
  startAt          DateTime
  endAt            DateTime
  eventBannerUrl   String?
  punishmentPfpUrl String?

  hostId String?
  host   User?   @relation("ChallengeHost", fields: [hostId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challengeColor   String?
  teams            Team[]
  participants     ChallengeParticipant[]
  punishments      PunishmentRecord[]
  leaderboardEntries LeaderboardEntry[]
  auditLogs        AuditLog[]

  @@index([hostId])
}

model Team {
  id          String @id @default(cuid())
  challengeId String
  name        String
  color       String?
  iconEmoji   String?
  mascotUrl   String?
  /// Law L1: Solo = 1, Duo = 2. Null for uncapped squad rosters (TEAM_VS_TEAM).
  maxMembers  Int?
  sortOrder   Int    @default(0)

  challenge    Challenge              @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]
  members      TeamMember[]

  @@unique([challengeId, name])
  @@index([challengeId])
}

model ChallengeParticipant {
  id            String            @id @default(cuid())
  challengeId   String
  userId        String
  teamId        String?
  targetSeconds Int               @default(0)
  status        ParticipantStatus @default(NORMAL)

  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  dailyStudyLogs   DailyStudyLog[]
  punishmentRecord PunishmentRecord?

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([teamId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Study logging (Law L8 — integer seconds; Law L5 — override audit fields)
// ---------------------------------------------------------------------------

model DailyStudyLog {
  id              String   @id @default(cuid())
  participantId   String
  logDate         DateTime @db.Date
  durationSeconds Int      @default(0)

  isOverride     Boolean @default(false)
  overrideById   String?
  overrideReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participant  ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  overrideBy   User?                @relation("LogOverrideAdmin", fields: [overrideById], references: [id], onDelete: SetNull)

  @@unique([participantId, logDate])
  @@index([participantId])
  @@index([logDate])
}

// ---------------------------------------------------------------------------
// Categorizable Todo List (User-scoped daily and weekly tasks)
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String   @db.VarChar(255)
  taskType  TaskType @default(DAILY) @map("task_type")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name, taskType])
  @@index([userId, taskType])
  @@map("categories")
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  categoryId  String
  title       String    @db.VarChar(255)
  taskType    TaskType  @map("task_type")
  sortOrder   Int        @default(0) @map("sort_order")
  isComplete  Boolean    @default(false) @map("is_complete")
  status      TaskStatus @default(TODO)
  dueDate     DateTime?  @map("due_date") @db.Date
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  completedAt DateTime?  @map("completed_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, taskType])
  @@index([userId, dueDate])
  @@index([categoryId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Accountability (Law L6 — dual-failure evaluation outcomes)
// ---------------------------------------------------------------------------

model PunishmentRecord {
  id                   String  @id @default(cuid())
  challengeId          String
  participantId        String  @unique
  isPunished           Boolean
  hoursDeficitSeconds  Int     @default(0)
  incompleteGoalsCount Int     @default(0)

  isPardoned   Boolean @default(false)
  pardonReason String?
  pardonedById String?

  evaluatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge   Challenge            @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participant ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  pardonedBy  User?                @relation("PardonAdmin", fields: [pardonedById], references: [id], onDelete: SetNull)

  @@index([challengeId])
  @@index([isPunished])
}

// ---------------------------------------------------------------------------
// Manual Weekly Leaderboard (Slice: Manual Weekly Challenge Leaderboard)
// ---------------------------------------------------------------------------

model TeamMember {
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@index([teamId])
  @@map("team_members")
}

model LeaderboardEntry {
  id           String   @id @default(cuid()) @map("entry_id")
  challengeId  String   @map("challenge_id")
  userId       String   @map("user_id")
  sessionHours Decimal  @map("session_hours") @db.Decimal(6, 2)
  slotDate     DateTime @map("slot_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("last_updated_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, slotDate])
  @@index([challengeId, slotDate])
  @@index([userId])
  @@map("leaderboard_entries")
}

// ---------------------------------------------------------------------------
// Feedback and Bug Reporting
// ---------------------------------------------------------------------------

model Feedback {
  id                 String                @id @default(cuid())
  feedbackNumber     Int                   @default(autoincrement()) @map("feedback_number")
  type               FeedbackType
  title              String                @db.VarChar(255)
  description        String                @db.Text
  url                String                @db.VarChar(1024)
  status             FeedbackStatus        @default(OPEN)

  logrocketSessionId String?               @map("logrocket_session_id")

  discordStatus      DiscordDeliveryStatus @default(PENDING) @map("discord_status")
  discordMessageId   String?               @map("discord_message_id")
  discordChannelId   String?               @map("discord_channel_id")

  userId             String?               @map("user_id")
  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@unique([feedbackNumber])
  @@index([type])
  @@index([status])
  @@index([discordStatus])
  @@index([userId])
  @@map("feedbacks")
}

// ---------------------------------------------------------------------------
// Audit Logging (Law L5 — Append-Only Immutable System Audit Trail)
// ---------------------------------------------------------------------------

model AuditLog {
  id               String   @id @default(cuid())
  challengeId      String?  @map("challenge_id")
  actorId          String?  @map("actor_id")
  actorUsername    String   @map("actor_username")
  actorDisplayName String?  @map("actor_display_name")
  actorImage       String?  @map("actor_image")
  actionType       String   @map("action_type") @db.VarChar(64)
  targetEntityId   String   @map("target_entity_id")
  targetEntityType String   @map("target_entity_type") @db.VarChar(64)
  targetEntityName String?  @map("target_entity_name") @db.VarChar(255)
  previousValue    Json?    @map("previous_value")
  newValue         Json?    @map("new_value")
  auditReason      String?  @map("audit_reason") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditLogsWritten", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([challengeId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([actionType])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  PARTICIPANT
  ADMIN
  DEV
}

enum ChallengeFormat {
  TEAM_VS_TEAM
  DUOS
  SOLOS
}

enum ParticipantStatus {
  NORMAL
  DEFICIT
  EXCUSED
  PUNISHED
}

enum TaskType {
  DAILY
  WEEKLY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CROSSED_OUT
}

enum FeedbackType {
  BUG
  ENHANCEMENT
}

enum FeedbackStatus {
  OPEN
  CLOSED
}

enum DiscordDeliveryStatus {
  PENDING
  SENT
  FAILED
}

