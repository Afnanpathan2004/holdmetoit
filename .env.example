# ==============================================================================
# HoldMeToIt — Environment Variables Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env or .env.local:
#    cp .env.example .env.local
# 2. Fill in the values for your environment.
# 3. NEVER commit real secret values to Git. (.env and .env*.local are gitignored)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for Prisma ORM.
#
# For Local Development:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/holdmetoit?schema=public"
#
# For Production with Supabase (Transaction Pooler - Port 6543 recommended for serverless):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# For Production with Neon (Pooled Connection):
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT-ID]-pooler.[REGION].aws.neon.tech/[DATABASE]?sslmode=require"
DATABASE_URL="postgresql://user:password@host:5432/holdmetoit?schema=public"

# Optional: Direct PostgreSQL connection URI (Port 5432) for running migrations
# when DATABASE_URL points to a transaction pooler (PgBouncer).
# DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. AUTH.JS / NEXTAUTH.JS V5 CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key used to encrypt session cookies and sign CSRF tokens.
# Generate a secure 32-byte secret in your terminal:
#   openssl rand -base64 32
# or:
#   npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

# Required on Vercel or reverse proxies to trust incoming X-Forwarded-Host headers.
# Defaults to true in NextAuth config, but explicitly setting it is best practice.
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 3. DISCORD OAUTH 2.0 (Identity Provider)
# ------------------------------------------------------------------------------
# Obtained from the Discord Developer Portal:
# https://discord.com/developers/applications
#
# Steps:
# 1. Create a "New Application" -> Name it "HoldMeToIt".
# 2. Go to "OAuth2" -> Copy "Client ID" and reset/copy "Client Secret".
# 3. Under "Redirects", add the callback URL:
#    - Local:      http://localhost:3000/api/auth/callback/discord
#    - Production: https://[YOUR-VERCEL-DOMAIN].vercel.app/api/auth/callback/discord
#    - Custom:     https://[YOUR-CUSTOM-DOMAIN]/api/auth/callback/discord
AUTH_DISCORD_ID="replace-with-discord-client-id"
AUTH_DISCORD_SECRET="replace-with-discord-client-secret"

# ------------------------------------------------------------------------------
# 3b. GOOGLE OAUTH 2.0 (Identity Provider)
# ------------------------------------------------------------------------------
# Obtained from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Steps:
# 1. Create a project -> OAuth consent screen -> External.
# 2. Under Credentials, create "OAuth client ID" -> "Web application".
# 3. Add Authorized redirect URI:
#    - Local:      http://localhost:3000/api/auth/callback/google
#    - Production: https://[YOUR-VERCEL-DOMAIN].vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# ------------------------------------------------------------------------------
# 4. APPLICATION URLS (Canonical Public URL)
# ------------------------------------------------------------------------------
# The canonical public URL of your deployment (used for links and metadata).
# Local:      http://localhost:3000
# Production: https://[YOUR-APP].vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment (development, test, production)
NODE_ENV="development"
