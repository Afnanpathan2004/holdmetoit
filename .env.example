# Database (PostgreSQL — Supabase / Neon)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Discord OAuth 2.0 (identify scope only — FEAT-AUTH-01)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

DISCORD_GUILD_ID=""
DISCORD_ADMIN_ROLE_IDS=""
DISCORD_BOT_TOKEN=""

# Discord Feedback & Bug Reporting Channels
DISCORD_FEEDBACK_CHANNEL_ID=""
DISCORD_FEEDBACK_BUG_CHANNEL_ID=""
DISCORD_FEEDBACK_SUGGESTIONS_CHANNEL_ID=""

# Platform Developers (Snowflake Discord IDs with full DEV & Host Admin privileges)
DEV_DISCORD_IDS='["<snowflake_id_1>", "<snowflake_id_2>"]'

# Supabase Storage (server-only — never prefix with NEXT_PUBLIC_)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="holdmetoit-bucket"
SUPABASE_EVENT_BANNERS_FOLDER="event-banners"
SUPABASE_PUNISHMENT_PFPS_FOLDER="punishment-pfps"
 
# YPT Automated Study Ingestion (FEAT-LOG-03)
YPT_INGEST_SECRET="generate-secure-token-for-ypt-bot-ingest"


